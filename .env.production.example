# Copier vers garageflow-backend/.env et adapter les secrets.
# Le frontend est compilé avec les ARG du Dockerfile (voir docker-compose.yml).

# --- Backend (garageflow-backend/.env) ---
NODE_ENV=production
PORT=5000
FRONTEND_URL=http://localhost:8080
MONGODB_URI=mongodb://mongo:27017/garageflow
JWT_ACCESS_SECRET=change-me-min-32-chars-please-use-random-string
JWT_REFRESH_SECRET=change-me-min-32-chars-please-use-random-string
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_FROM=noreply@example.com
AUTOREF_API_KEY=
AUTOREF_BASE_URL=https://api-gateway.autoref.eu

# --- Build frontend (docker-compose build args ou fichier .env.production local Vite) ---
# VITE_API_URL=http://localhost:5000/api/v1
# VITE_SOCKET_URL=http://localhost:5000
