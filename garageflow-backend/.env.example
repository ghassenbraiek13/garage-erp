NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

MONGODB_URI=mongodb://localhost:27017/garageflow

JWT_ACCESS_SECRET=garageflow_access_secret_change_in_production_min_64_chars_xxxxxxxxxxxxxxxx
JWT_REFRESH_SECRET=garageflow_refresh_secret_change_in_production_min_64_chars_xxxxxxxxxxxxxxxx
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=your_ethereal_user
SMTP_PASS=your_ethereal_pass
SMTP_FROM="GarageFlow <noreply@garageflow.app>"

UPLOAD_MAX_SIZE_MB=5
UPLOADS_DIR=./uploads

NHTSA_API_URL=https://vpic.nhtsa.dot.gov/api/vehicles

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

LOG_LEVEL=debug
