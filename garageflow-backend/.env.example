# Copy to .env and fill values
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173
MONGODB_URI=mongodb://localhost:27017/garageflow
JWT_ACCESS_SECRET=change-me-min-32-characters-long-secret
JWT_REFRESH_SECRET=change-me-min-32-characters-long-refresh
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=GarageFlow <noreply@garageflow.app>
AUTOREF_API_KEY=
AUTOREF_BASE_URL=https://api-gateway.autoref.eu

# Rate limiting (ignored when NODE_ENV=development)
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=500
# AUTH_RATE_LIMIT_MAX=30

# Optional: n8n webhooks (falls back to SMTP / chatbot fallback if unset)
N8N_INVOICE_WEBHOOK_URL=
N8N_CHATBOT_WEBHOOK_URL=https://garageflow.app.n8n.cloud/webhook/garageflow-chatbot
BACKEND_URL=http://localhost:5000
